<local:GlassWindow x:Class="TaskWall.BoardWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:TaskWall"
                   Title="TaskWall"
                   AllowDrop="True"
                   FontFamily="{StaticResource UiFont}"
                   Foreground="{StaticResource Fg}">
    <Grid x:Name="BodyRoot" Background="Transparent" DragOver="Root_DragOver" PreviewMouseDown="BodyRoot_PreviewMouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="BacklogColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Board -->
        <DockPanel x:Name="BoardArea" Margin="12,8,12,10">
            <!-- top bar: navigation + views (icons) | actions, sync, layer (icons) – icons are drawn in code (src/Icons.cs) -->
            <Grid DockPanel.Dock="Top" Height="32" Margin="0,0,0,4" Background="Transparent" MouseRightButtonUp="Bar_RightClick">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE76B;" Click="Prev_Click" ToolTip="Wstecz"/>
                    <TextBlock x:Name="RangeText" VerticalAlignment="Center" Margin="6,0" FontSize="12"/>
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE76C;" Click="Next_Click" ToolTip="Dalej"/>
                    <Button x:Name="TodayButton" Style="{StaticResource BarIcon}" Click="Today_Click" Margin="4,0,0,0" ToolTip="Dziś"/>
                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource Line}"/>
                    <Border x:Name="ViewSwitch" CornerRadius="8" Background="{StaticResource Hover}" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DayViewButton" Style="{StaticResource BarIcon}" Click="DayView_Click" ToolTip="Dzień"/>
                            <Button x:Name="OneWeekButton" Style="{StaticResource BarIcon}" Click="OneWeek_Click" ToolTip="1 tydzień"/>
                            <Button x:Name="WeekViewButton" Style="{StaticResource BarIcon}" Click="WeekView_Click" ToolTip="2 tygodnie"/>
                            <Button x:Name="MonthViewButton" Style="{StaticResource BarIcon}" Click="MonthView_Click" ToolTip="Miesiąc"/>
                            <Button x:Name="YearButton" Style="{StaticResource BarIcon}" Click="Year_Click" ToolTip="Rok"/>
                            <Button x:Name="TimelineButton" Style="{StaticResource BarIcon}" Click="Timeline_Click" ToolTip="Timeline (6)"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="OverdueButton" Style="{StaticResource BarButton}" Click="Overdue_Click" Margin="8,0,0,0"
                            Visibility="Collapsed" ToolTip="Przenieś niezrobione zadania z minionych dni na dziś"/>
                    <TextBlock x:Name="SyncText" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource FgFaint}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SearchButton" Style="{StaticResource BarIcon}" Click="Search_Click" ToolTip="Szukaj wszędzie (Ctrl+F)"/>
                    <Button x:Name="BacklogButton" Style="{StaticResource BarIcon}" Click="ToggleBacklog_Click" AllowDrop="True" ToolTip="Backlog"/>
                    <Button x:Name="ArchiveButton" Style="{StaticResource BarIcon}" Click="ToggleArchive_Click" AllowDrop="True"
                            ToolTip="Zarchiwizowane zadania (upuść tu zadanie, żeby je zarchiwizować)"/>
                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource Line}"/>
                    <Button x:Name="SyncButton" Style="{StaticResource BarIcon}" Click="Sync_Click"/>
                    <Button x:Name="AlarmButton" Style="{StaticResource BarIcon}" Click="Alarm_Click" ToolTip="Alarmy i spotkania"/>
                    <Button x:Name="LayerButton" Style="{StaticResource BarIcon}" Click="Layer_Click" ToolTip="Warstwa (Ctrl+1 / Ctrl+2)"/>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="More_Click" ToolTip="Więcej" FontSize="16"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Ustawienia" FontSize="16"/>
                    <Button x:Name="HideButton" Style="{StaticResource IconButton}" Content="&#xE921;" Click="Hide_Click" ToolTip="Ukryj tablicę (pokażesz ją ikoną w zasobniku albo skrótem)" FontSize="15"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ContentHost">
                <Grid x:Name="WeeksGrid"/>
                <Grid x:Name="YearHost" Visibility="Collapsed"/>
                <Grid x:Name="TimelineHost" Visibility="Collapsed"/>
                <Grid x:Name="DayHost" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>

        <!-- Backlog: pinned column or slide-out drawer -->
        <Grid x:Name="BacklogPanel" Grid.Column="1">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DrawerShift"/>
            </Grid.RenderTransform>
            <Border x:Name="DrawerGlass"/>
            <Border x:Name="BacklogSurface" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Line}">
                <DockPanel Margin="14,10,8,10">
                    <Grid DockPanel.Dock="Top" Height="28" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BacklogTabButton" Style="{StaticResource LinkButton}" Click="BacklogTab_Click" Padding="8,3" AllowDrop="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BACKLOG" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock x:Name="BacklogCount" Margin="7,0,0,0" Foreground="{StaticResource FgFaint}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ArchiveTabButton" Style="{StaticResource LinkButton}" Click="ArchiveTab_Click" Padding="8,3" Margin="4,0,0,0" AllowDrop="True"
                                    ToolTip="Zarchiwizowane zadania. Przeciągnij na dzień, żeby przywrócić.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ARCHIWUM" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock x:Name="ArchiveCount" Margin="7,0,0,0" Foreground="{StaticResource FgFaint}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DrawerLockButton" Style="{StaticResource IconButton}" Click="DrawerLock_Click" Margin="4,0,0,0" FontSize="12"/>
                        </StackPanel>
                        <Button x:Name="EmptyArchiveButton" HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Click="EmptyArchive_Click"
                                Content="Opróżnij" FontSize="12" Visibility="Collapsed" ToolTip="Przenieś całe archiwum tej warstwy do kosza"/>
                        <Button x:Name="ImportButton" HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Click="Import_Click"
                                ToolTip="Wczytaj zadania z eksportu Notion (CSV albo ZIP)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Import z Notion" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,6,4,6">
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" TextChanged="Search_Changed" Padding="22,3,6,3" FontSize="12"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource FgFaint}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Filtruj backlog…" Foreground="{StaticResource FgFaint}" FontSize="12"
                                   Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                        <WrapPanel x:Name="TagChips" Margin="0,0,4,0"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="BacklogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" AllowDrop="True" Padding="0,0,4,0">
                        <StackPanel x:Name="BacklogList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Global search (Ctrl+F) -->
        <Border x:Name="SearchPanel" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Width="680" Margin="0,40,12,12"
                CornerRadius="12" Background="{DynamicResource DialogBg}" BorderBrush="{StaticResource InkMid}" BorderThickness="1">
            <DockPanel Margin="12">
                <Grid DockPanel.Dock="Top">
                    <TextBox x:Name="GlobalSearch" Style="{StaticResource FieldBox}" Padding="26,5,6,5" FontSize="13" TextChanged="GlobalSearch_Changed"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource FgFaint}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="GlobalSearchHint" Text="Szukaj w zadaniach, seriach, spotkaniach i archiwum…" Foreground="{StaticResource FgFaint}" FontSize="13"
                               Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="SearchInfo" DockPanel.Dock="Top" Margin="4,8,0,4" FontSize="11" Foreground="{StaticResource FgFaint}"/>
                <ScrollViewer x:Name="SearchScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SearchResults"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <!-- "Zarchiwizowano · COFNIJ" after an archive / delete -->
        <Border x:Name="UndoBar" Grid.ColumnSpan="2" Panel.ZIndex="30" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" CornerRadius="10" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1" Padding="14,6,6,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UndoText" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,12,0"/>
                <Button Style="{StaticResource BarButton}" Content="COFNIJ" Click="UndoBar_Click" Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</local:GlassWindow>
